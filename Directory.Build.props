<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>CrankyAnt</Authors>
    <Version>0.2.0</Version>
    <BuildArtifactsRoot Condition="'$(BuildArtifactsRoot)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'RailroaderScenePatcherBuild'))</BuildArtifactsRoot>
    <BaseOutputPath>$(BuildArtifactsRoot)/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BuildArtifactsRoot)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
